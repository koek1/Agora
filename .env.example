# ── MongoDB ───────────────────────────────
MONGO_INITDB_ROOT_USERNAME=akademia
MONGO_INITDB_ROOT_PASSWORD=changeme_in_production
MONGO_DB_NAME=akademia
MONGO_URI=mongodb://akademia:changeme_in_production@localhost:27017/akademia?authSource=admin

# ── RabbitMQ ──────────────────────────────
RABBITMQ_DEFAULT_USER=akademia
RABBITMQ_DEFAULT_PASS=changeme_in_production
RABBITMQ_URL=amqp://akademia:changeme_in_production@localhost:5672


# ── Redis ─────────────────────────────────
REDIS_URL=redis://localhost:6379


# ── JWT ───────────────────────────────────
JWT_SECRET=replace_with_64_random_bytes_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Backend ───────────────────────────────
BACKEND_PORT=3000
NODE_ENV=development

# ── Mobile (Expo) ─────────────────────────
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# ── CORS ─────────────────────────
# Comma-seperated list of allowed frontend origins. Replace with real domain in production
ALLOWED_ORIGINS=http://localhost:3001

# ── Geoapify (adres-soektog) ──────────────
GEOAPIFY_API_KEY=replace_with_your_geoapify_api_key